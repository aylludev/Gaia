# Django Configuration
# Copiar este archivo a .env y configurar los valores reales
# NUNCA commitear el archivo .env al repositorio

# Django Secret Key - Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-real-secret-key

# Debug Mode - Usar False en producción
DJANGO_DEBUG=False

# Allowed Hosts - Lista separada por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Configuration
DB_NAME=ams
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# Currency Configuration
# Código de moneda predeterminada al hacer login (COP, USD, EUR, etc.)
DEFAULT_CURRENCY_CODE=COP

# Email Configuration (opcional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
